# NoteNest environment configuration
# The app uses PostgreSQL in every environment (local, CI, production).
# Set SESSION_SECRET to a private random value of at least 32 characters.
# Without it, non-production sessions use a random per-process key and expire on restart.
DATABASE_URL="postgresql://notenest:notenest@localhost:55432/notenest?schema=public"
SESSION_SECRET="replace-with-a-random-secret-at-least-32-characters"
PORT=3000
# FLY_API_TOKEN is optional locally (prefer flyctl auth login). CI stores it as a repo secret.

# Replace before running the Docker Compose stack.
POSTGRES_PASSWORD=replace-me
POSTGRES_PORT=55432
APP_PORT=3000
