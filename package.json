{
  "name": "notenest",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:test": "pnpm run test:integration",
    "test:integration": "node scripts/run-integration-tests.mjs"
  },
  "devDependencies": {
    "@types/node": "^24",
    "eslint": "^9.13.0",
    "prettier": "^3.3.3",
    "prisma": "^6.19.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.13.0",
    "vitest": "^2.1.4"
  },
  "packageManager": "pnpm@9.15.9",
  "dependencies": {
    "@prisma/client": "^6.19.0"
  }
}
