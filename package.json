{
  "name": "notenest",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --check \".github/workflows/ci.yml\" \"backend/**/*.ts\" \"frontend/src/**/*.{ts,tsx,css}\" \"frontend/index.html\" \"scripts/*.{js,mjs,cjs}\" \"src/**/*.ts\" \"tests/**/*.ts\" \"tests/tsconfig.json\" \"*.{ts,js}\" \"package.json\"",
    "typecheck": "tsc --noEmit && tsc -p backend/tsconfig.json && tsc -p frontend/tsconfig.json && tsc -p tests/tsconfig.json",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:test": "pnpm run test:integration",
    "test:integration": "node scripts/run-integration-tests.mjs",
    "dev": "concurrently \"vite --config vite.config.ts --host 127.0.0.1\" \"tsx watch backend/server.ts\"",
    "build": "bash scripts/build.sh",
    "start": "node dist/server.js",
    "verify": "bash scripts/verify.sh",
    "test:browser": "playwright test"
  },
  "devDependencies": {
    "@types/node": "^24",
    "eslint": "^9.13.0",
    "prettier": "^3.3.3",
    "prisma": "^6.19.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.13.0",
    "vitest": "^2.1.4",
    "@playwright/test": "^1.64.1",
    "@types/express": "^5.0.3",
    "@types/express-session": "^1.18.2",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.5.2",
    "concurrently": "^9.1.2",
    "esbuild": "^0.25.5",
    "tsx": "^4.20.3",
    "vite": "^6.3.5"
  },
  "packageManager": "pnpm@9.15.9",
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "express-session": "^1.18.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.2"
  }
}
